MOMENTO_POSTGRES_DSN=postgres://momento:momento-local-only@postgres:5432/momento?sslmode=disable
MOMENTO_BOOTSTRAP_ADMIN=admin@example.com
MOMENTO_BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-long-random-password
# 발급한 API key와 Tracking Key, OIDC Client Secret, Delivery Header를 암호화해 저장합니다.
# 같은 값을 유지하면 서비스를 재기동해도 키를 다시 발급하거나 입력할 필요가 없습니다.
# 32 byte base64/hex 또는 16자 이상 passphrase. 예: openssl rand -base64 32
MOMENTO_ENCRYPTION_KEY=change-this-to-a-long-random-encryption-key
# 키를 교체할 때만 이전 키를 쉼표로 나열하고, 재암호화 후 제거하십시오.
# MOMENTO_ENCRYPTION_KEY_PREVIOUS=
